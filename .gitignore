.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.env
!.env.example
*.db
*.sqlite
*.sqlite3

# Cached model responses for the evals. Committed results must be reproducible from a
# clone by running the eval, not by shipping its answers.
evals/.cache/

# Generated by scripts/build_site.py from evals/results/. Committing the output would let a
# stale page outlive the run that produced it — the one thing the build exists to prevent.
site/

# Local Cloudflare CLI cache — holds the account id, and is per-machine state.
.wrangler/
