# Copy to .env (gitignored) and fill in your Razorpay TEST-MODE credentials.
# Dashboard -> Settings -> API Keys (generate in Test Mode, not Live Mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks -> (create/select endpoint) -> Secret.
# Used to verify X-Razorpay-Signature on inbound webhook deliveries.
RAZORPAY_WEBHOOK_SECRET=
