# Copy to .env (gitignored) and fill in your Razorpay TEST-MODE credentials.
# Dashboard -> Settings -> API Keys (generate in Test Mode, not Live Mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks -> (create/select endpoint) -> Secret.
# Used to verify X-Razorpay-Signature on inbound webhook deliveries.
RAZORPAY_WEBHOOK_SECRET=

# Ring 1.3 onward. https://aistudio.google.com/apikey -> Create API key.
# Only needed to *run* the ablation; every test and the retrieval eval work without it.
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys. Free tier allows thousands of requests/day,
# which is what makes the Ring 1.3 ablation (186 calls) runnable and, more importantly,
# RE-runnable. Gemini's free tier caps gemini-3.5-flash at 20/day. See FAILURES.md.
GROQ_API_KEY=

# NVIDIA NIM — https://build.nvidia.com. Credit-based free tier rather than a request cap,
# which suits a 186-call batch better than Gemini's 20/day or Groq's daily token budget.
NVIDIA_API_KEY=

# Optional, and off unless set. Gates state-changing requests on a public deployment —
# reading stays open, so the queue, a case, the corpus and the measurement are all browsable
# without it. Only Confirm/Correct/Reject and the refund gate need it, because on a public URL
# one POST spends model credits and writes into a corpus that later cases are resolved from.
#
# Not authentication: no accounts, no identity, everyone holding it is the same anonymous
# operator. Set it, then open /unlock?key=... once in the browser you demo from.
#
# Leave it empty locally. Unset means off, and the absence of a key is never a lock-out.
PRECEDENT_WRITE_KEY=
