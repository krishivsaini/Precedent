# Everything the image must not carry. Two entries here are about correctness rather than
# size: `.env` would bake test-mode credentials into a layer, and `*.db` would ship a
# database that the volume is supposed to provide — a stale one, silently, on every deploy.
.env
*.db
*.sqlite
*.sqlite3

.git/
.github/
.venv/
.pytest_cache/
**/__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Generated by scripts/build_site.py and deployed to Cloudflare Pages, not to the container.
site/

# Cached model responses. Committed results must be reproducible by running the eval.
evals/.cache/

docs/
tests/
FAILURES.md
README.md
